# Copy this file to .env.local and fill in the values from
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration.
# The same six variables go into Vercel → Project → Settings → Environment Variables.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Where listing photos go:
#   storage = Cloud Storage for Firebase (needs the Blaze plan; falls back to inline automatically if an upload fails)
#   inline  = a small compressed thumbnail stored inside the Firestore document (works on the free Spark plan)
NEXT_PUBLIC_IMAGE_MODE=storage
